{
  "expo": {
    "name": "MDConverter",
    "slug": "mdconverter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mdconverter",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "package": "com.mdconverter",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mdconverter",
      "supportsTablet": false,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "LSItemContentTypes": ["com.adobe.pdf"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "Word Document",
            "LSItemContentTypes": [
              "org.openxmlformats.wordprocessingml.document",
              "com.microsoft.word.doc"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "PowerPoint Presentation",
            "LSItemContentTypes": [
              "org.openxmlformats.presentationml.presentation",
              "com.microsoft.powerpoint.ppt"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "Excel Spreadsheet",
            "LSItemContentTypes": [
              "org.openxmlformats.spreadsheetml.sheet",
              "com.microsoft.excel.xls"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "HTML Document",
            "LSItemContentTypes": ["public.html", "public.xhtml"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "CSV Spreadsheet",
            "LSItemContentTypes": ["public.comma-separated-values-text"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "JSON",
            "LSItemContentTypes": ["public.json"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "XML",
            "LSItemContentTypes": ["public.xml"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "Plain Text",
            "LSItemContentTypes": ["public.plain-text"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "EPUB",
            "LSItemContentTypes": ["org.idpf.epub-container"],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
